{
    "name": "petroslabs/fr-validator",
    "description": "Framework-agnostic validators for French identifiers (NIR, RIB, SIRET/SIREN, IBAN, phone numbers)",
    "type": "library",
    "license": "MIT",
    "keywords": ["validation", "france", "nir", "siret", "siren", "rib", "iban"],
    "authors": [
        {
            "name": "PetrosLabs",
            "homepage": "https://petroslabs.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/petroslabs/fr-validator/issues",
        "source": "https://github.com/petroslabs/fr-validator"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "PetrosLabs\\FrValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PetrosLabs\\FrValidator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@stan",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
